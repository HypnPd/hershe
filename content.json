  "text": {
    "name": "HERSHE",
    "heroEyebrow": "HOUSE · ELECTRO · R&B",
    "heroTagline": "A DJ set from Hershe is a story — deep house and electro house build the floor, R&B and indie bring it home.",
    "aboutEyebrow": "About",
    "aboutTitle": "She reads the room, then she runs it.",
    "aboutBody1": "Hershe is a DJ and producer based in Isabela, Philippines, moving between deep house, electro house, R&B and indie — genres she picked for the same reason people pick her sets: they're built around a feeling, not just a beat.",
    "aboutBody2": "In just over a year behind the decks she's played rooms of every size, from a corporate debut at the Disneyland Hotel to intimate bar nights, always reading the crowd first and building the set around them.",
    "aboutBody3": "Music has been her language since childhood — performing on Pinoy Big Brother at ten years old, fronting her high school band, and now producing mixes as personal as they are danceable.",
    "aboutSignature": "Hershe",
    "aboutSignatureRole": "DJ / Producer — Isabela, PH",
